{
  "order-ci-plugin-hooks": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "python scripts/hooks/on_session_start.py",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/pre_tool_security_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/hooks/post_tool_audit_logger.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/hooks/on_stop_quality_gate.py",
        "timeout": 30
      }
    ]
  }
}
