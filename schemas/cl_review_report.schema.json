{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agy2HeadlessCLReviewReport",
  "description": "Google Antigravity 2.0 Headless CL/CI 結構化審查報告 Schema (對應第 7.2.4 節 --json-schema)",
  "type": "object",
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "BLOCK"],
      "description": "最終門禁判定：存在 critical 為 BLOCK，僅 warning 為 WARN，無問題為 PASS"
    },
    "summary": {
      "type": "string",
      "description": "本次 CL/PR 變更的整體安全性與架構審查摘要"
    },
    "critical_count": {
      "type": "integer",
      "minimum": 0
    },
    "warning_count": {
      "type": "integer",
      "minimum": 0
    },
    "harness_verification": {
      "type": "object",
      "properties": {
        "rules_loaded": { "type": "boolean" },
        "skill_executed": { "type": "string" },
        "mcp_schema_verified": { "type": "boolean" },
        "subagent_delegated": { "type": "string" },
        "hooks_active": { "type": "boolean" }
      },
      "required": [
        "rules_loaded",
        "skill_executed",
        "mcp_schema_verified",
        "subagent_delegated",
        "hooks_active"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rule_id": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "warning", "suggestion"]
          },
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "detected_by": {
            "type": "string",
            "description": "標明是由哪個 Harness 元素檢出 (如 Skill:ast_pci_scanner, MCP:sqlite-schema-mcp, Subagent:pci-compliance-auditor)"
          },
          "problem": { "type": "string" },
          "fix": { "type": "string" }
        },
        "required": ["rule_id", "severity", "file", "line", "detected_by", "problem", "fix"]
      }
    }
  },
  "required": [
    "verdict",
    "summary",
    "critical_count",
    "warning_count",
    "harness_verification",
    "issues"
  ]
}
